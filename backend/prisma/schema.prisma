generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexão usada em runtime pela aplicação (role restrita "fluxa_app" —
  // sem UPDATE/DELETE em audit_log, ver scripts/run-hardening.ts).
  url       = env("DATABASE_URL")
  // Conexão usada só por `prisma migrate` (role superusuária, dona das
  // tabelas). Precisa ser diferente da de runtime: revogar privilégios do
  // próprio dono da tabela não tem efeito nenhum no Postgres.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum RoleUsuario {
  OPERADOR
  SUPERVISOR
  GERENTE
  ADMIN
}

enum PeriodoTurno {
  MANHA
  TARDE
  NOITE
  INTEGRAL
}

enum StatusTurno {
  ABERTO
  FECHADO
}

enum TipoMovimentacao {
  VENDA
  SANGRIA
  SUPRIMENTO
  CANCELAMENTO
  DEVOLUCAO
  AJUSTE
}

enum FormaPagamento {
  DINHEIRO
  DEBITO
  CREDITO
  PIX
  VALE
  FIADO
  OUTRO
}

enum StatusMovimentacao {
  ATIVA
  PENDENTE_CONFERENCIA
  ESTORNADA
}

enum StatusFechamento {
  CONTAGEM_PENDENTE
  CONTAGEM_REALIZADA
  CALCULADO
  CONFIRMADO
}

enum ClassificacaoFechamento {
  EXATO
  SOBRA
  FALTA
}

enum AcaoAuditoria {
  LOGIN
  LOGIN_FALHO
  LOGOUT
  ABERTURA_CAIXA
  TENTATIVA_ABERTURA_DUPLICADA
  FECHAMENTO_CAIXA
  TROCA_OPERADOR
  MOVIMENTACAO_CRIADA
  SANGRIA
  SUPRIMENTO
  CANCELAMENTO
  DEVOLUCAO
  AJUSTE
  CONFERENCIA_CRUZADA
  ALTERACAO_CONFIG
  LEITURA_X
  ALERTA_TETO_GAVETA
  FECHAMENTO_AUTOMATICO_ALERTA
  FECHAMENTO_AUTOMATICO_FORCADO
  EXPORTACAO_RELATORIO
  USUARIO_CRIADO
  USUARIO_ATUALIZADO
  IMPORTACAO_EXTRATO_CARTAO
  CONCILIACAO_EXECUTADA
  CONCILIACAO_RESOLVIDA_MANUAL
  CONTA_CRIADA
  ASSINATURA_ATUALIZADA
  ASSINATURA_PAGAMENTO_CONFIRMADO
  ASSINATURA_PAGAMENTO_FALHOU
}

enum TipoIntegracao {
  FISCAL
  MAQUININHA
  NOTIFICACAO
}

enum StatusIntegracao {
  NAO_APLICAVEL
  SIMULADO
  PENDENTE
  SUCESSO
  ERRO
}

enum CanalNotificacao {
  EMAIL
  WHATSAPP
}

enum StatusNotificacao {
  DESABILITADO
  PENDENTE
  ENVIADO
  ERRO
}

enum StatusExtrato {
  PROCESSANDO
  CONCLUIDO
  ERRO
}

enum Bandeira {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OUTRA
}

enum ModalidadeCartao {
  DEBITO
  CREDITO_A_VISTA
  CREDITO_PARCELADO
}

enum StatusConciliacaoTransacao {
  CONCILIADO
  DIVERGENTE
  SEM_VENDA
  MANUAL
  IGNORADO
}

enum StatusConciliacaoMovimentacao {
  SEM_EXTRATO
  CONCILIADO
  DIVERGENTE
  PENDENTE_REVISAO
  MANUAL
}

enum CicloAssinatura {
  MENSAL
  ANUAL
}

enum StatusAssinatura {
  TRIAL
  ATIVA
  INADIMPLENTE
  CANCELADA
}

enum StatusPagamento {
  PENDENTE
  CONFIRMADO
  FALHOU
  CANCELADO
}

enum TipoNotificacao {
  TURNO_ABERTO_HORAS_DEMAIS
  DIVERGENCIA_ACIMA_TOLERANCIA
  SANGRIA_ALTA_SEM_CONFERENCIA
  CONCILIACAO_PENDENTE_REVISAO
  DIVERGENCIA_RECORRENTE
  ASSINATURA_TRIAL_EXPIRANDO
  ASSINATURA_PAGAMENTO_PENDENTE
  ASSINATURA_PAGAMENTO_CONFIRMADO
  ASSINATURA_PAGAMENTO_FALHOU
}

enum SeveridadeNotificacao {
  INFO
  ATENCAO
  URGENTE
}

// ============================================================
// CADASTRO / TENANT
// ============================================================

model Loja {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String?  @unique
  segmento  String?
  endereco  String?
  timezone  String   @default("America/Sao_Paulo")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  terminais    Terminal[]
  usuarios     UsuarioLoja[]
  configuracao ConfiguracaoLoja?
  turnos       TurnoCaixa[]
  auditLogs    AuditLog[]
  relatorios   RelatorioFechamento[]
  notificacoes NotificacaoResumoDiario[]
  contadores   Contador[]

  extratosCartao         ExtratoCartao[]
  transacoesExtrato      TransacaoExtratoCartao[]
  conciliacoesCartao     ConciliacaoCartao[]
  taxasContratadasCartao TaxaContratadaCartao[]

  assinatura           Assinatura?
  notificacoesInternas Notificacao[]

  @@map("lojas")
}

model Terminal {
  id        String   @id @default(uuid())
  lojaId    String
  loja      Loja     @relation(fields: [lojaId], references: [id])
  codigo    String
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  turnos TurnoCaixa[]

  @@unique([lojaId, codigo])
  @@map("terminais")
}

model Usuario {
  id         String      @id @default(uuid())
  nome       String
  email      String      @unique
  telefone   String?
  senhaHash  String
  roleGlobal RoleUsuario
  superAdmin Boolean     @default(false)
  ativo      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  lojas         UsuarioLoja[]
  refreshTokens RefreshToken[]

  turnosAbertos     TurnoCaixa[] @relation("TurnoOperadorAbertura")
  turnosResponsavel TurnoCaixa[] @relation("TurnoOperadorResponsavel")
  turnosFechados    TurnoCaixa[] @relation("TurnoOperadorFechamento")
  turnosSupervisor  TurnoCaixa[] @relation("TurnoSupervisorFechamento")

  movimentacoes            MovimentacaoCaixa[] @relation("MovimentacaoOperador")
  movimentacoesAutorizadas MovimentacaoCaixa[] @relation("MovimentacaoAutorizadoPor")
  movimentacoesConferidas  MovimentacaoCaixa[] @relation("MovimentacaoConferidoPor")

  trocasComoAnterior TrocaOperador[] @relation("TrocaOperadorAnterior")
  trocasComoNovo     TrocaOperador[] @relation("TrocaOperadorNovo")
  trocasAutorizadas  TrocaOperador[] @relation("TrocaOperadorAutorizadoPor")

  fechamentosConfirmados FechamentoCaixa[]
  auditLogs              AuditLog[]

  extratosCartaoImportados ExtratoCartao[]
  conciliacoesResolvidas   ConciliacaoCartao[]

  notificacoesPessoais Notificacao[]

  @@map("usuarios")
}

model UsuarioLoja {
  id        String      @id @default(uuid())
  usuarioId String
  usuario   Usuario     @relation(fields: [usuarioId], references: [id])
  lojaId    String
  loja      Loja        @relation(fields: [lojaId], references: [id])
  role      RoleUsuario
  ativo     Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@unique([usuarioId, lojaId])
  @@map("usuarios_lojas")
}

model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])
  tokenHash  String    @unique
  criadoEmIp String?
  expiraEm   DateTime
  revogadoEm DateTime?
  createdAt  DateTime  @default(now())

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ============================================================
// CAIXA / TURNO
// ============================================================

model TurnoCaixa {
  id               String       @id @default(uuid())
  lojaId           String
  loja             Loja         @relation(fields: [lojaId], references: [id])
  terminalId       String
  terminal         Terminal     @relation(fields: [terminalId], references: [id])
  numeroSequencial Int
  periodo          PeriodoTurno
  status           StatusTurno  @default(ABERTO)

  operadorAberturaId         String
  operadorAbertura           Usuario  @relation("TurnoOperadorAbertura", fields: [operadorAberturaId], references: [id])
  operadorResponsavelAtualId String
  operadorResponsavelAtual   Usuario  @relation("TurnoOperadorResponsavel", fields: [operadorResponsavelAtualId], references: [id])
  operadorFechamentoId       String?
  operadorFechamento         Usuario? @relation("TurnoOperadorFechamento", fields: [operadorFechamentoId], references: [id])
  supervisorFechamentoId     String?
  supervisorFechamento       Usuario? @relation("TurnoSupervisorFechamento", fields: [supervisorFechamentoId], references: [id])

  dataAbertura          DateTime  @default(now())
  dataFechamento        DateTime?
  fundoTrocoInformado   Decimal   @db.Decimal(12, 2)
  fundoTrocoSugerido    Decimal?  @db.Decimal(12, 2)
  observacoesAbertura   String?
  observacoesFechamento String?
  fechamentoAutomatico  Boolean   @default(false)

  movimentacoes  MovimentacaoCaixa[]
  trocasOperador TrocaOperador[]
  fechamento     FechamentoCaixa?
  relatorio      RelatorioFechamento?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([terminalId, numeroSequencial])
  @@index([lojaId, status])
  @@index([terminalId, status])
  @@map("turnos_caixa")
}

model TrocaOperador {
  id                 String     @id @default(uuid())
  turnoId            String
  turno              TurnoCaixa @relation(fields: [turnoId], references: [id])
  operadorAnteriorId String
  operadorAnterior   Usuario    @relation("TrocaOperadorAnterior", fields: [operadorAnteriorId], references: [id])
  operadorNovoId     String
  operadorNovo       Usuario    @relation("TrocaOperadorNovo", fields: [operadorNovoId], references: [id])
  motivo             String?
  autorizadoPorId    String?
  autorizadoPor      Usuario?   @relation("TrocaOperadorAutorizadoPor", fields: [autorizadoPorId], references: [id])
  createdAt          DateTime   @default(now())

  @@index([turnoId])
  @@map("trocas_operador")
}

model MovimentacaoCaixa {
  id             String           @id @default(uuid())
  turnoId        String
  turno          TurnoCaixa       @relation(fields: [turnoId], references: [id])
  tipo           TipoMovimentacao
  formaPagamento FormaPagamento?
  valor          Decimal          @db.Decimal(12, 2)
  motivo         String?
  descricao      String?

  // Melhoria B (offline/sincronização): chave gerada no cliente antes de
  // qualquer tentativa de rede — reenviar a mesma operação nunca duplica.
  chaveIdempotencia String? @unique

  // Melhoria C (conciliação de cartões): NSU devolvido pelo adapter de
  // maquininha, indexado aqui para o motor de conciliação nível 1 não
  // precisar vasculhar o Json de IntegracaoLog a cada execução.
  nsuMaquininha String?

  operadorId      String
  operador        Usuario   @relation("MovimentacaoOperador", fields: [operadorId], references: [id])
  autorizadoPorId String?
  autorizadoPor   Usuario?  @relation("MovimentacaoAutorizadoPor", fields: [autorizadoPorId], references: [id])
  conferidoPorId  String?
  conferidoPor    Usuario?  @relation("MovimentacaoConferidoPor", fields: [conferidoPorId], references: [id])
  conferidoEm     DateTime?

  vendaReferenciaId String?
  vendaReferencia   MovimentacaoCaixa?  @relation("MovimentacaoEstorno", fields: [vendaReferenciaId], references: [id])
  estornos          MovimentacaoCaixa[] @relation("MovimentacaoEstorno")

  status        StatusMovimentacao @default(ATIVA)
  motivoEstorno String?
  estornadaEm   DateTime?

  integracoes       IntegracaoLog[]
  conciliacaoCartao ConciliacaoCartao?

  createdAt DateTime @default(now())

  @@index([turnoId, tipo])
  @@index([turnoId, formaPagamento])
  @@index([createdAt])
  @@index([nsuMaquininha])
  @@map("movimentacoes_caixa")
}

// ============================================================
// FECHAMENTO (REDUÇÃO Z)
// ============================================================

model FechamentoCaixa {
  id                     String                   @id @default(uuid())
  turnoId                String                   @unique
  turno                  TurnoCaixa               @relation(fields: [turnoId], references: [id])
  status                 StatusFechamento         @default(CONTAGEM_PENDENTE)
  causaDivergencia       String?
  divergenciaTotal       Decimal?                 @db.Decimal(12, 2)
  classificacaoGeral     ClassificacaoFechamento?
  ajusteAutomaticoGerado Boolean                  @default(false)
  confirmadoPorId        String?
  confirmadoPor          Usuario?                 @relation(fields: [confirmadoPorId], references: [id])
  confirmadoEm           DateTime?
  createdAt              DateTime                 @default(now())

  contagens FechamentoContagemForma[]

  @@map("fechamentos_caixa")
}

model FechamentoContagemForma {
  id             String                   @id @default(uuid())
  fechamentoId   String
  fechamento     FechamentoCaixa          @relation(fields: [fechamentoId], references: [id])
  formaPagamento FormaPagamento
  valorContado   Decimal                  @db.Decimal(12, 2)
  valorEsperado  Decimal?                 @db.Decimal(12, 2)
  divergencia    Decimal?                 @db.Decimal(12, 2)
  classificacao  ClassificacaoFechamento?
  contadoEm      DateTime                 @default(now())
  calculadoEm    DateTime?

  @@unique([fechamentoId, formaPagamento])
  @@map("fechamento_contagens_forma")
}

model RelatorioFechamento {
  id               String     @id @default(uuid())
  turnoId          String     @unique
  turno            TurnoCaixa @relation(fields: [turnoId], references: [id])
  lojaId           String
  loja             Loja       @relation(fields: [lojaId], references: [id])
  numeroSequencial Int
  conteudoJson     Json
  hashIntegridade  String
  geradoEm         DateTime   @default(now())

  @@unique([lojaId, numeroSequencial])
  @@map("relatorios_fechamento")
}

// ============================================================
// CONFIGURAÇÃO / AUDITORIA
// ============================================================

model ConfiguracaoLoja {
  id                               String   @id @default(uuid())
  lojaId                           String   @unique
  loja                             Loja     @relation(fields: [lojaId], references: [id])
  tetoGavetaDinheiro               Decimal  @default(500) @db.Decimal(12, 2)
  toleranciaDivergencia            Decimal  @default(5) @db.Decimal(12, 2)
  valorMinimoConferenciaCruzada    Decimal  @default(200) @db.Decimal(12, 2)
  horaFechamentoAutomatico         String   @default("23:59")
  fecharAutomaticamenteSemContagem Boolean  @default(false)
  diasHistoricoMediaTroco          Int      @default(30)
  emailsGestorResumoDiario         String[] @default([])
  toleranciaDiasConciliacaoCartao  Int      @default(2)
  updatedAt                        DateTime @updatedAt

  @@map("configuracoes_loja")
}

model AuditLog {
  id           String        @id @default(uuid())
  lojaId       String?
  loja         Loja?         @relation(fields: [lojaId], references: [id])
  usuarioId    String?
  usuario      Usuario?      @relation(fields: [usuarioId], references: [id])
  acao         AcaoAuditoria
  entidade     String
  entidadeId   String?
  detalhesJson Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime      @default(now())

  @@index([lojaId, createdAt])
  @@index([usuarioId])
  @@index([acao])
  @@map("audit_log")
}

model Contador {
  id         String @id @default(uuid())
  lojaId     String
  loja       Loja   @relation(fields: [lojaId], references: [id])
  chave      String
  valorAtual Int    @default(0)

  @@unique([lojaId, chave])
  @@map("contadores")
}

// ============================================================
// INTEGRAÇÕES (adapters — stub nesta v1)
// ============================================================

model IntegracaoLog {
  id              String             @id @default(uuid())
  tipo            TipoIntegracao
  movimentacaoId  String?
  movimentacao    MovimentacaoCaixa? @relation(fields: [movimentacaoId], references: [id])
  status          StatusIntegracao   @default(NAO_APLICAVEL)
  payloadEnvio    Json?
  payloadResposta Json?
  erro            String?
  createdAt       DateTime           @default(now())

  @@index([tipo, status])
  @@map("integracao_log")
}

model NotificacaoResumoDiario {
  id                String            @id @default(uuid())
  lojaId            String
  loja              Loja              @relation(fields: [lojaId], references: [id])
  data              DateTime
  destinatarios     String[]
  canal             CanalNotificacao
  status            StatusNotificacao @default(DESABILITADO)
  conteudoJson      Json?
  tentativas        Int               @default(0)
  ultimaTentativaEm DateTime?
  createdAt         DateTime          @default(now())

  @@unique([lojaId, data, canal])
  @@map("notificacoes_resumo_diario")
}

// ============================================================
// CONCILIAÇÃO DE CARTÕES (Melhoria C)
// ============================================================

model ExtratoCartao {
  id                String        @id @default(uuid())
  lojaId            String
  loja              Loja          @relation(fields: [lojaId], references: [id])
  adquirente        String
  nomeArquivo       String
  hashArquivo       String
  mapeamentoColunas Json?
  status            StatusExtrato @default(PROCESSANDO)
  totalLinhas       Int           @default(0)
  totalImportadas   Int           @default(0)
  erro              String?
  importadoPorId    String
  importadoPor      Usuario       @relation(fields: [importadoPorId], references: [id])
  createdAt         DateTime      @default(now())

  transacoes TransacaoExtratoCartao[]

  @@unique([lojaId, hashArquivo])
  @@map("extratos_cartao")
}

model TransacaoExtratoCartao {
  id                    String            @id @default(uuid())
  extratoId             String
  extrato               ExtratoCartao     @relation(fields: [extratoId], references: [id])
  lojaId                String
  loja                  Loja              @relation(fields: [lojaId], references: [id])
  nsu                   String?
  autorizacao           String?
  bandeira              Bandeira?
  modalidade            ModalidadeCartao?
  parcelas              Int               @default(1)
  numeroParcela         Int               @default(1)
  valorBruto            Decimal           @db.Decimal(12, 2)
  valorLiquido          Decimal           @db.Decimal(12, 2)
  valorTaxa             Decimal           @db.Decimal(12, 2)
  dataVenda             DateTime
  dataPagamentoPrevista DateTime
  linhaOriginal         Json

  usadaEmConciliacao Boolean            @default(false)
  conciliacao        ConciliacaoCartao?

  createdAt DateTime @default(now())

  @@index([lojaId, dataVenda])
  @@index([nsu])
  @@index([lojaId, usadaEmConciliacao])
  @@map("transacoes_extrato_cartao")
}

model ConciliacaoCartao {
  id                 String                        @id @default(uuid())
  lojaId             String
  loja               Loja                          @relation(fields: [lojaId], references: [id])
  movimentacaoId     String?                       @unique
  movimentacao       MovimentacaoCaixa?            @relation(fields: [movimentacaoId], references: [id])
  transacaoExtratoId String?                       @unique
  transacaoExtrato   TransacaoExtratoCartao?       @relation(fields: [transacaoExtratoId], references: [id])
  statusMovimentacao StatusConciliacaoMovimentacao @default(SEM_EXTRATO)
  statusTransacao    StatusConciliacaoTransacao?
  nivelConfianca     Int?
  diferencaValor     Decimal?                      @db.Decimal(12, 2)
  observacao         String?
  resolvidoPorId     String?
  resolvidoPor       Usuario?                      @relation(fields: [resolvidoPorId], references: [id])
  resolvidoEm        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([lojaId, statusMovimentacao])
  @@map("conciliacoes_cartao")
}

model TaxaContratadaCartao {
  id             String           @id @default(uuid())
  lojaId         String
  loja           Loja             @relation(fields: [lojaId], references: [id])
  bandeira       Bandeira
  modalidade     ModalidadeCartao
  parcelas       Int              @default(1)
  taxaPercentual Decimal          @db.Decimal(5, 2)
  vigenteDesde   DateTime         @default(now())

  @@unique([lojaId, bandeira, modalidade, parcelas, vigenteDesde])
  @@map("taxas_contratadas_cartao")
}

// ============================================================
// CADASTRO PÚBLICO / PLANOS / ASSINATURA (pagamento via InfinitePay)
// ============================================================

model Plano {
  id              String   @id @default(uuid())
  nome            String   @unique
  descricao       String?
  funcionalidades String[] @default([])
  valorMensal     Decimal  @db.Decimal(10, 2)
  valorAnual      Decimal  @db.Decimal(10, 2)
  limiteTerminais Int?
  ordem           Int      @default(0)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assinaturas Assinatura[]
  pagamentos  Pagamento[]

  @@map("planos")
}

model Assinatura {
  id              String           @id @default(uuid())
  lojaId          String           @unique
  loja            Loja             @relation(fields: [lojaId], references: [id])
  planoId         String?
  plano           Plano?           @relation(fields: [planoId], references: [id])
  ciclo           CicloAssinatura?
  status          StatusAssinatura @default(TRIAL)
  trialFim        DateTime
  periodoAtualFim DateTime?
  canceladaEm     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  pagamentos Pagamento[]

  @@map("assinaturas")
}

model Pagamento {
  id             String          @id @default(uuid())
  assinaturaId   String
  assinatura     Assinatura      @relation(fields: [assinaturaId], references: [id])
  planoId        String
  plano          Plano           @relation(fields: [planoId], references: [id])
  ciclo          CicloAssinatura
  valor          Decimal         @db.Decimal(10, 2)
  status         StatusPagamento @default(PENDENTE)
  checkoutId     String?         @unique
  checkoutUrl    String?
  pagoEm         DateTime?
  payloadWebhook Json?
  createdAt      DateTime        @default(now())

  @@index([assinaturaId])
  @@map("pagamentos")
}

model Notificacao {
  id         String                @id @default(uuid())
  lojaId     String
  loja       Loja                  @relation(fields: [lojaId], references: [id])
  usuarioId  String?
  usuario    Usuario?              @relation(fields: [usuarioId], references: [id])
  tipo       TipoNotificacao
  severidade SeveridadeNotificacao @default(INFO)
  titulo     String
  mensagem   String
  entidade   String?
  entidadeId String?
  lidaEm     DateTime?
  createdAt  DateTime              @default(now())

  @@unique([lojaId, tipo, entidadeId])
  @@index([lojaId, lidaEm])
  @@index([lojaId, createdAt])
  @@map("notificacoes")
}
