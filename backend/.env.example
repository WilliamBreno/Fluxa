# Banco de dados
# DIRECT_DATABASE_URL: role superusuária ("postgres"), usada só por `prisma
# migrate` e pelo script de hardening (npm run db:hardening).
# DATABASE_URL: role restrita "fluxa_app" (criada pelo hardening), usada pela
# aplicação em runtime — sem UPDATE/DELETE em audit_log.
POSTGRES_SUPERUSER_PASSWORD=fluxa_dev_superuser_password
FLUXA_APP_PASSWORD=fluxa_dev_app_password
# Porta 5434 (não 5432): evita conflito com um PostgreSQL nativo já
# instalado na máquina, ou com outro projeto Docker usando 5433. Ajuste se
# necessário — precisa bater com a porta do host em docker-compose.yml.
DIRECT_DATABASE_URL="postgresql://postgres:fluxa_dev_superuser_password@localhost:5434/fluxa?schema=public"
DATABASE_URL="postgresql://fluxa_app:fluxa_dev_app_password@localhost:5434/fluxa?schema=public"

# Servidor
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Autenticação
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-em-producao
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-em-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Integrações (v1: apenas stubs simulados, sem provedor real conectado)
FISCAL_PROVIDER=stub
MAQUININHA_PROVIDER=stub
NOTIFICACAO_PROVIDER=stub

# Timezone padrão para jobs agendados
DEFAULT_TIMEZONE=America/Sao_Paulo
